@model MerceariaMVC.Models.Cliente

<div class="crud-container">

```
<div class="titulo-pagina">
    <span style="font-size: 30px;">👤</span>
    <div>
        <h1 class="mb-0">Detalhes do Cliente</h1>
        <p class="text-muted mb-0">Visualize as informações cadastradas</p>
    </div>
</div>

<div class="card p-4">

    <dl class="row mb-0">

        <dt class="col-sm-3">
            Nome
        </dt>
        <dd class="col-sm-9">
            @Html.DisplayFor(model => model.Nome)
        </dd>

        <dt class="col-sm-3">
            E-mail
        </dt>
        <dd class="col-sm-9">
            @Html.DisplayFor(model => model.Email)
        </dd>

        <dt class="col-sm-3">
            Idade
        </dt>
        <dd class="col-sm-9">
            @Html.DisplayFor(model => model.Idade)
        </dd>

        <dt class="col-sm-3">
            Status
        </dt>
        <dd class="col-sm-9">
            @if (Model.Ativo)
            {
                <span class="badge bg-success">Ativo</span>
            }
            else
            {
                <span class="badge bg-danger">Inativo</span>
            }
        </dd>

    </dl>

</div>

<div class="mt-4">

    <a asp-action="Edit" asp-route-id="@Model.Id"
       class="btn btn-warning">
        Editar
    </a>

    <a asp-action="Index" class="btn btn-secondary">
        Voltar
    </a>

</div>
```

</div>
